# OpenBiz Box environment template
COMPOSE_PROJECT_NAME=openbiz
TZ=Australia/Sydney
OPENBIZ_DOMAIN=example.com

# Core
POSTGRES_USER=openbiz
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openbiz
REDIS_PASSWORD=CHANGE_ME

# Authentik
AUTHENTIK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME

# n8n
N8N_HOST=automation.example.com
N8N_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# AI
LITELLM_MASTER_KEY=CHANGE_ME
OLLAMA_BASE_URL=http://ollama:11434
QDRANT_API_KEY=CHANGE_ME

# LiveKit
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=openbiz-dev
LIVEKIT_API_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# Optional external AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Never commit a populated .env file.
