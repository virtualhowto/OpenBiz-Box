# OpenBiz Box environment template
COMPOSE_PROJECT_NAME=openbiz
TZ=Australia/Sydney
OPENBIZ_DOMAIN=example.com

# Core
POSTGRES_USER=openbiz
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=openbiz
REDIS_PASSWORD=CHANGE_ME

# Authentik
AUTHENTIK_TAG=2026.5
AUTHENTIK_SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME
# Optional first-run bootstrap. Prefer a generated password hash for automated installs.
AUTHENTIK_BOOTSTRAP_PASSWORD_HASH=

# n8n
N8N_HOST=automation.example.com
N8N_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# AI
LITELLM_MASTER_KEY=CHANGE_ME
OLLAMA_BASE_URL=http://ollama:11434
QDRANT_API_KEY=CHANGE_ME
OPENBIZ_DEFAULT_MODEL=openbiz-local

# LiveKit / Voice
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=openbiz-dev
LIVEKIT_API_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
OPENBIZ_VOICE_STT_MODEL=deepgram/nova-3:en
OPENBIZ_VOICE_LLM_MODEL=openai/gpt-4o-mini
OPENBIZ_VOICE_TTS_MODEL=inworld/inworld-tts-2:Ashley

# Optional external AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Never commit a populated .env file.
